{
  "this_kme": {
    "id": 1, // KME id over KME network
    "nickname": "Alice", // Optional KME nickname for logging
    "db_uri": "sqlite://kme1_database.db",
    "delete_key_file_after_read": false, // Whether to delete key files after reading them (for in-memory database, set to false)
    "key_directory_to_watch": "raw_keys/kme-1-1", // Quantum Key directory for SAEs belonging to this KME (only to be compliant with standard, as these SAEs can use public key cryptography directly)
    "transport_mode": "zenoh_raft", // Startup transport mode: https or zenoh_raft
    "zenoh_transport": {
      "node_id": "kme-1-zenoh",
      "listen_endpoint": "tls/localhost:7447",
      // Optional bootstrap hint, not required for reachability: peers/KMEs are discovered
      // automatically via Zenoh scouting (multicast + gossip, enabled by default - see
      // ZenohScoutingConfig). Kept here because multicast scouting over loopback can be
      // unreliable in local dev setups; in a real deployment this can usually be omitted.
      //"peers": ["tls/localhost:7448"],
      "role": "peer",
      // "scouting": { "multicast_interface": "eth0" } // uncomment to pin the multicast interface (e.g. in multi-NIC containers)
      "tls": {
        "root_ca_certificate": "certs/inter_kmes/zenoh_ca_bundle.crt",    // CA bundle to validate the other KME's Zenoh cert
        "certificate": "certs/inter_kmes/kme1_server.crt",                // KME Zenoh node cert (used for both server and client connections)
        "private_key": "certs/inter_kmes/kme1_server.key"                 // KME Zenoh node key (used for both server and client connections)
      },
      "raft": {
        "cluster_members": ["kme-1-zenoh", "kme-2-zenoh"], // Node-ids participating in Raft consensus, including this node
        "leader_id": "kme-1-zenoh" // Statically configured Raft leader (no election yet)
      }
    },
    "saes_https_interface": {
      "listen_address": "0.0.0.0:13000", // Listening address for connections of SAEs belonging to this KME
      "ca_client_cert_path": "certs/kme-1-local-zone/ca.crt", // CA cert to validate SAE client certs
      "server_cert_path": "certs/kme-1-local-zone/kme_server.crt", // KME server cert for SAE connections
      "server_key_path": "certs/kme-1-local-zone/kme_server.key" // KME server key for SAE connections
    },
    "debugging_http_interface": "0.0.0.0:18080", // Optional HTTP debugging interface (unsecured, no auth)
    "log_level": "trace", // Optional log verbosity: error, warn, info, debug or trace (defaults to info)
    "kmes_https_interface": {
      "listen_address": "0.0.0.0:13001", // Listening address for inter-KME connections
      "ca_client_cert_path": "certs/inter_kmes/ca_kme1.crt", // CA cert to validate inter-KME client certs
      "server_cert_path": "certs/inter_kmes/kme1_server.crt", // KME server cert for inter-KME connections
      "server_key_path": "certs/inter_kmes/kme1_server.key" // KME server key for inter-KME connections
    }
  },
  "other_kmes": [
    {
      "id": 2, // KME id of the other KME
      "key_directory_to_watch": "raw_keys/kme-1-2", // Quantum Key directory for communication between SAEs of KME 1 and KME 2
      "inter_kme_bind_address": "localhost:14001", // Address of the other KME to connect to
      "ignore_system_proxy_settings": true, // Ignore system proxy settings when connecting to the other KME. If not set, default to false
      "https_client_authentication_certificate": "certs/inter_kmes/kme1-to-kme2.pfx", // Client cert to authenticate to the other KME
      "https_client_authentication_certificate_password": "password", // Password for the client cert (empty if none)
      "zenoh_node_id": "kme-2-zenoh" // Zenoh node_id of the other KME, used to address it directly when transport_mode is zenoh_raft
    },
    {
      "id": 3, // KME id of the other KME
      "key_directory_to_watch": "raw_keys/kme-1-3", // Quantum Key directory for communication between SAEs of KME 1 and KME 3 (dedicated pool - do NOT reuse kme-1-2, which is KME1<->KME2's exclusive pre-shared material)
      // Classical HTTPS fields below are unused with transport_mode: zenoh_raft (no classical inter-KME server/client is started for KME3), kept as harmless s reusing existing files
      "inter_kme_bind_address": "localhost:14001",
      "https_client_authentication_certificate": "certs/inter_kmes/kme1-to-kme2.pfx",
      "https_client_authentication_certificate_password": "password",
      "zenoh_node_id": "kme-3-zenoh" // Zenoh node_id of the other KME, used to address it directly when transport_mode is zenoh_raft
    }
  ],
  "saes": [
    {
      "id": 1, // SAE id over SAE network (must be unique for each SAE across the whole network)
      "kme_id": 1, // KME id this SAE belongs to
      "https_client_certificate_serial": [ // Expected serial number of the SAE's client certificate, if SAE belongs to this KME
        0x70,
        0xf4,
        0x4f,
        0x56,
        0xc,
        0x3f,
        0x27,
        0xd4,
        0xb2,
        0x11,
        0xa4,
        0x78,
        0x13,
        0xaf,
        0xd0,
        0x3c,
        0x3,
        0x81,
        0x3b,
        0x8e
      ]
    },
    {
      "id": 2, // SAE id over SAE network (must be unique for each SAE across the whole network)
      "kme_id": 1, // KME id this SAE belongs to
      "https_client_certificate_serial": [ // Expected serial number of the SAE's client certificate, if SAE belongs to this KME
        0x70,
        0xf4,
        0x4f,
        0x56,
        0xc,
        0x3f,
        0x27,
        0xd4,
        0xb2,
        0x11,
        0xa4,
        0x78,
        0x13,
        0xaf,
        0xd0,
        0x3c,
        0x3,
        0x81,
        0x3b,
        0x92
      ]
    },
    {
      "id": 3, // SAE id over SAE network (must be unique for each SAE across the whole network)
      "kme_id": 2 // KME id this SAE belongs to
    }
  ]
}